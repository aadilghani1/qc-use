# Copy to qa/.env (for your app) or .env (for this repo). Keep it out of git.

# One Vercel AI Gateway key runs Jev and the text helper. https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Optional: call TypeSafe directly instead of the gateway.
# JEV_PROVIDER=typesafe
# TYPESAFE_API_KEY=

# Optional: another text helper. Any OpenAI-compatible endpoint works.
# TEXT_MODEL=inception/mercury-2.5
# TEXT_MODEL_BASE_URL=https://ai-gateway.vercel.sh/v1
# TEXT_MODEL_API_KEY=
# TEXT_MODEL_REASONING=none

# Secrets for your tests, by name.
# LOGIN_EMAIL=
# LOGIN_PASSWORD=
